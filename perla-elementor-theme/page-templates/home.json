          "settings": {
            "html": "<section class=\"hero hero--split\">\n  <div class=\"hero__left\">\n    <div class=\"hero__content\">\n      <p class=\"hero__kicker\">UGC Creator</p>\n      <h1 class=\"hero__title\">Perla<br>Desjardins</h1>\n      <span class=\"hero__line\" aria-hidden=\"true\"></span>\n      <p class=\"hero__role\"><span class=\"hero__asterisk\" aria-hidden=\"true\">\u2726</span> Beauty \u00b7 Fashion \u00b7 Lifestyle</p>\n      <p class=\"hero__tagline\">Authentic content for brands that want to stand out.</p>\n      <p class=\"hero__callout\"><span class=\"hero__callout-star\" aria-hidden=\"true\">\u2726</span> Available for collaborations</p>\n      <div class=\"hero__cta-wrap\">\n        <a href=\"/work-with-me/\" class=\"btn hero__cta\">Get in touch</a>\n        <a href=\"#reels\" class=\"hero__cta-secondary\">View my work \u2192</a>\n      </div>\n      <div class=\"hero__socials footer-socials\" aria-label=\"Social links\">\n        <a href=\"https://www.instagram.com/perla.desjardins/\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Instagram\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z\"/></svg></a>\n        <a href=\"https://www.tiktok.com/@perla.desjardins\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"TikTok\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z\"/></svg></a>\n        <a href=\"https://www.youtube.com/@perladesjardins\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"YouTube\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z\"/></svg></a>\n        <a href=\"https://linktr.ee/perladesjardins\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Linktree\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 500 500\" fill=\"none\"><path d=\"M226.993 168.546L173.931 114L143.128 145.546L198.786 198.607H120.499V242.395H199.157L143.128 296.822L173.931 327.745L249.993 251.312L326.055 327.745L356.859 296.941L300.829 242.515H379.501V198.607H301.214L356.872 145.546L326.069 114L273.007 168.546V91H226.993V168.546ZM273.007 305.102H226.993V409H273.007V305.102Z\" fill=\"currentColor\"/></svg></a>\n      </div>\n    </div>\n  </div>\n  <div class=\"hero__right\">\n    <div class=\"hero__image-frame\">\n      <div class=\"hero__image-wrap\">\n        <img src=\"{{IMAGES}}/hero-portrait.png\" alt=\"Perla Desjardins\" class=\"hero__image\">\n      </div>\n    </div>\n  </div>\n</section>\n\n<section class=\"home-brands\" aria-label=\"Brands I've worked with\">\n  <div class=\"container home-brands__container\">\n    <div class=\"home-brands__label\"><span class=\"deco-star\" aria-hidden=\"true\">\u2726</span> Select collaborations</div>\n    <div class=\"home-brands__marquee\" aria-hidden=\"true\">\n      <div class=\"home-brands__track\">\n        <img src=\"{{IMAGES}}/hm.svg\" alt=\"H&amp;M\" class=\"home-brands__logo\">\n        <img src=\"{{IMAGES}}/moxies.svg\" alt=\"Moxies\" class=\"home-brands__logo\">\n        <img src=\"{{IMAGES}}/dandurand.svg\" alt=\"Dandurand Wine\" class=\"home-brands__logo home-brands__logo--dandurand\">\n        <img src=\"{{IMAGES}}/dji.svg\" alt=\"DJI\" class=\"home-brands__logo\">\n      </div>\n    </div>\n  </div>\n</section>\n\n<section class=\"home-blurb animate-on-scroll\" aria-labelledby=\"home-blurb-title\">\n  <div class=\"container home-blurb__container\">\n    <p class=\"home-blurb__label\"><span class=\"deco-star\" aria-hidden=\"true\">\u2726</span> About</p>\n    <div class=\"home-blurb__inner\">\n      <h2 class=\"home-blurb__title\" id=\"home-blurb-title\">A bit about me</h2>\n      <p class=\"home-blurb__text\">I'm Perla \u2014 a UGC creator focused on beauty, fashion, and lifestyle. I work with brands to create authentic, scroll-stopping content that feels real and relatable. I love bringing products and stories to life in a way that fits your brand voice and connects with your audience.</p>\n      <p class=\"home-blurb__callout\"><span class=\"callout\"><span class=\"deco-star\" aria-hidden=\"true\">\u2726</span> Available for collaborations</span></p>\n      <a href=\"/about/\" class=\"home-blurb__link\">Read more about me \u2192</a>\n    </div>\n  </div>\n</section>\n\n<section class=\"home-reels\" id=\"reels\" aria-labelledby=\"home-reels-title\">\n  <div class=\"container home-reels__container\">\n    <p class=\"home-reels__label\"><span class=\"deco-star\" aria-hidden=\"true\">\u2726</span> Work</p>\n    <div class=\"section-title animate-on-scroll\" id=\"home-reels-title\">\n      <h2>Reels</h2>\n      <p>Top reels from <a href=\"https://www.instagram.com/perla.desjardins/\" target=\"_blank\" rel=\"noopener noreferrer\">@perla.desjardins</a>. Replace the reel ID in each slot with your Reel's ID from its link (or paste the full embed from Reel \u2192 \u22ef \u2192 Embed).</p>\n    </div>\n    <div class=\"home-reels__grid-wrap\">\n      <div class=\"featured-work__grid\">\n        <div class=\"featured-work__slot animate-on-scroll animate-delay-1\"><blockquote class=\"instagram-media\" data-instgrm-permalink=\"https://www.instagram.com/p/DU6WLLxgZxz/\" data-instgrm-version=\"14\"></blockquote></div>\n        <div class=\"featured-work__slot animate-on-scroll animate-delay-2\"><blockquote class=\"instagram-media\" data-instgrm-permalink=\"https://www.instagram.com/reel/DU7DmbEjINW/\" data-instgrm-version=\"14\"></blockquote></div>\n        <div class=\"featured-work__slot animate-on-scroll animate-delay-3\"><blockquote class=\"instagram-media\" data-instgrm-permalink=\"https://www.instagram.com/reel/DUZm21vDJ5u/\" data-instgrm-version=\"14\"></blockquote></div>\n        <div class=\"featured-work__slot animate-on-scroll animate-delay-4\"><blockquote class=\"instagram-media\" data-instgrm-permalink=\"https://www.instagram.com/reel/DULX5hFjsfD/\" data-instgrm-version=\"14\"></blockquote></div>\n      </div>\n    </div>\n    <p class=\"featured-work__more\">\n      <a href=\"https://www.instagram.com/perla.desjardins/\" target=\"_blank\" rel=\"noopener noreferrer\">More reels on Instagram</a> <span aria-hidden=\"true\"> \u00b7 </span> <a href=\"/gallery/\">View full gallery</a>\n    </p>\n  </div>\n</section>\n\n<section class=\"quick-links animate-on-scroll\" aria-labelledby=\"quick-links-title\">\n  <div class=\"container\">\n    <p class=\"quick-links__label\"><span class=\"deco-star\" aria-hidden=\"true\">\u2726</span> Explore</p>\n    <h2 class=\"quick-links__title\" id=\"quick-links-title\">Next steps</h2>\n    <p class=\"quick-links__intro\">Learn more, see my work, or get in touch.</p>\n    <div class=\"quick-links__grid\">\n      <a href=\"/about/\" class=\"quick-link-card animate-on-scroll animate-delay-1\"><span class=\"quick-link-card__label\">About me</span><span class=\"quick-link-card__arrow\">\u2192</span></a>\n      <a href=\"/gallery/\" class=\"quick-link-card animate-on-scroll animate-delay-2\"><span class=\"quick-link-card__label\">Gallery</span><span class=\"quick-link-card__arrow\">\u2192</span></a>\n      <a href=\"/services/\" class=\"quick-link-card animate-on-scroll animate-delay-3\"><span class=\"quick-link-card__label\">Services</span><span class=\"quick-link-card__arrow\">\u2192</span></a>\n      <a href=\"/work-with-me/\" class=\"quick-link-card animate-on-scroll animate-delay-4\"><span class=\"quick-link-card__label\">Work with me</span><span class=\"quick-link-card__arrow\">\u2192</span></a>\n    </div>\n  </div>\n</section>\n"
