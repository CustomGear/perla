          "settings": {
            "html": "<section class=\"work-hero\">\n  <div class=\"container\">\n    <p class=\"work-hero__label\"><span class=\"deco-star\" aria-hidden=\"true\">\u2726</span> Collaborations & inquiries</p>\n    <h1>Work with me</h1>\n    <p class=\"work-hero__intro\">Ready to create scroll-stopping content? Share your brand, campaign idea, or budget \u2014 I reply within 24\u201348 hours.</p>\n    <div class=\"work-hero__badges\">\n      <p class=\"callout\"><span class=\"deco-star\" aria-hidden=\"true\">\u2726</span> Available for collaborations</p>\n      <p class=\"work-hero__badge\">24\u201348h response time</p>\n    </div>\n  </div>\n</section>\n\n<section class=\"work-section\" aria-labelledby=\"work-form-title\">\n  <div class=\"container work-container\">\n    <div class=\"work-form-card\">\n      <h2 id=\"work-form-title\">Send a message</h2>\n      <p class=\"work-form-card__note\">Include your brand, timeline, or budget \u2014 the more context, the better I can help.</p>\n      <form class=\"work-form\" action=\"https://formspree.io/f/YOUR_FORMSPREE_ID\" method=\"POST\" id=\"contact-form\">\n        <input type=\"hidden\" name=\"_subject\" value=\"New inquiry from Perla's portfolio\">\n        <div class=\"work-form__field\">\n          <label for=\"name\">Name</label>\n          <input type=\"text\" id=\"name\" name=\"name\" placeholder=\"Your name\" required autocomplete=\"name\">\n        </div>\n        <div class=\"work-form__field\">\n          <label for=\"email\">Email</label>\n          <input type=\"email\" id=\"email\" name=\"email\" placeholder=\"you@example.com\" required autocomplete=\"email\">\n        </div>\n        <div class=\"work-form__field\">\n          <label for=\"brand\">Brand / Company <span class=\"work-form__optional\">optional</span></label>\n          <input type=\"text\" id=\"brand\" name=\"brand\" placeholder=\"Brand or company name\" autocomplete=\"organization\">\n        </div>\n        <div class=\"work-form__field\">\n          <label for=\"message\">Message</label>\n          <textarea id=\"message\" name=\"message\" placeholder=\"Tell me about your project, goals, timeline \u2014 or just say hello!\" required rows=\"5\"></textarea>\n        </div>\n        <button type=\"submit\" class=\"btn btn--filled work-form__submit\">Send message</button>\n      </form>\n      <p class=\"work-form__hint\">I read every message personally and reply within 24\u201348 hours.</p>\n    </div>\n\n    <div class=\"work-contact-card\">\n      <div class=\"work-contact-card__profile\">\n        <img src=\"{{IMAGES}}/hero-portrait.png\" alt=\"Perla Desjardins\" class=\"work-contact-card__avatar\">\n        <div class=\"work-contact-card__profile-text\">\n          <p class=\"work-contact-card__name\">Perla Desjardins</p>\n          <p class=\"work-contact-card__tagline\">UGC Creator \u00b7 Beauty \u00b7 Fashion \u00b7 Lifestyle</p>\n        </div>\n      </div>\n      <p class=\"work-contact-card__intro\">Reach out directly \u2014 I'm here for collabs, rates, and creative partnerships.</p>\n      <div class=\"work-contact-list\">\n        <a href=\"mailto:collabs@perladesjardins.com\" class=\"work-contact-item\" id=\"contact-email\">\n          <span class=\"work-contact-item__icon\" aria-hidden=\"true\">\u2709</span>\n          <span class=\"work-contact-item__content\">\n            <span class=\"work-contact-item__label\">Email</span>\n            <span class=\"work-contact-item__value\">collabs@perladesjardins.com</span>\n          </span>\n          <span class=\"work-contact-item__arrow\">\u2192</span>\n        </a>\n        <a href=\"https://www.instagram.com/perla.desjardins/\" class=\"work-contact-item\" id=\"contact-instagram\" target=\"_blank\" rel=\"noopener noreferrer\">\n          <span class=\"work-contact-item__icon\" aria-hidden=\"true\">\u25ce</span>\n          <span class=\"work-contact-item__content\">\n            <span class=\"work-contact-item__label\">Instagram</span>\n            <span class=\"work-contact-item__value\">@perla.desjardins</span>\n          </span>\n          <span class=\"work-contact-item__arrow\">\u2192</span>\n        </a>\n        <div class=\"work-contact-item work-contact-item--static\">\n          <span class=\"work-contact-item__icon\" aria-hidden=\"true\">\u25c7</span>\n          <span class=\"work-contact-item__content\">\n            <span class=\"work-contact-item__label\">Location</span>\n            <span class=\"work-contact-item__value\">Ottawa, ON</span>\n          </span>\n        </div>\n      </div>\n      <p class=\"work-contact-card__cta\">DM for collabs, rates, or just to say hi.</p>\n    </div>\n  </div>\n</section>\n"
          },
          "elements": []
        }
      ]
    }
  ]
